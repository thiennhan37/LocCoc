      "type": "string"
    },
    {
      "key": "password",
      "value": "correct horse battery staple 2026",
      "type": "string"
    },
    {
      "key": "phone",
      "value": "+84901234567",
      "type": "string"
    },
    {
      "key": "otp",
      "value": "000000",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
