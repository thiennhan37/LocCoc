{
  "info": {
    "_postman_id": "a4c8e3b2-5d9f-4f3f-8b0a-1e7c6f2d9a10",
    "name": "LocCoc IAM - API Gateway",
    "description": "Postman collection for testing LocCoc APIs through api-gateway. Auth endpoints are grouped under Auth Service and are sent to the gateway URL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "email",
      "value": "person@example.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "correct horse battery staple 2026",
      "type": "string"
    },
    {
      "key": "phone",
      "value": "+84901234567",
      "type": "string"
    },
    {
      "key": "otp",
      "value": "000000",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "API Gateway",
      "description": "Các request kiểm tra gateway dùng trực tiếp gatewayUrl.",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/health",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Kiểm tra gateway đang hoạt động. Kết quả mong đợi: { \"status\": \"ok\" }."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth Service",
      "description": "Các endpoint của auth-service. Tất cả request trong folder này đều đi qua api-gateway và không gọi trực tiếp auth-service.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"phone\": \"{{phone}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/auth/register",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Tạo tài khoản pending và phát hành OTP. Ở development, mã OTP được in trong console của auth-service."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Register returns an expected status', function () {",
                  "  pm.expect([201, 409, 429]).to.include(pm.response.code);",
                  "});",
                  "const body = pm.response.json();",
                  "if (body.userId) pm.collectionVariables.set('userId', body.userId);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/auth/verify-otp",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "auth",
                "verify-otp"
              ]
            },
            "description": "Xác thực OTP. Cập nhật collection variable otp bằng mã được log ở auth-service trước khi gửi."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Verify OTP returns HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response contains verified flag', function () {",
                  "  pm.expect(pm.response.json()).to.have.property('verified');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"channel\": \"email\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/auth/resend-otp",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "auth",
                "resend-otp"
              ]
            },
            "description": "Gửi lại OTP. Gửi ngay sau Register có thể trả 429 vì cooldown 60 giây; hãy chờ rồi thử lại."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Resend OTP returns an expected status', function () {",
                  "  pm.expect([200, 429]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/auth/login",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Đăng nhập tài khoản đã được kích hoạt bằng Verify OTP."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns an expected status', function () {",
                  "  pm.expect([200, 401, 429]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}

