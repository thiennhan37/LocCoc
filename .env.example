# Copy to .env; supply your own passwords and PEM keys before starting apps.
NODE_ENV=development
GATEWAY_PORT=8080
AUTH_PORT=8000
USER_PORT=8081
AUTH_SERVICE_URL=http://127.0.0.1:8000
USER_SERVICE_URL=http://127.0.0.1:8081
POSTGRES_ADMIN_PASSWORD=replace-me
POSTGRES_HOST_PORT=5433
DB_HOST=127.0.0.1
DB_PORT=5433
AUTH_DB_NAME=auth
AUTH_DB_USER=auth_service
AUTH_DB_PASSWORD=replace-me
USER_DB_NAME=user
USER_DB_USER=user_service
USER_DB_PASSWORD=replace-me
REDIS_HOST_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
JWT_PRIVATE_KEY_PATH=../secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=../secrets/jwt-public.pem
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
