# Copy to .env; supply your own passwords and PEM keys before starting apps.
NODE_ENV=development
GATEWAY_PORT=8080
AUTH_PORT=8000
USER_PORT=8081
AUTH_SERVICE_URL=http://127.0.0.1:8000
USER_SERVICE_URL=http://127.0.0.1:8081
POSTGRES_ADMIN_PASSWORD=postgres
POSTGRES_HOST_PORT=5433
DB_HOST=127.0.0.1
DB_PORT=5433
AUTH_DB_NAME=auth
AUTH_DB_USER=auth_service
AUTH_DB_PASSWORD=auth_dbpw
USER_DB_NAME=user
USER_DB_USER=user_service
USER_DB_PASSWORD=user_dbpw
REDIS_HOST_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
ARGON2_HASH_LENGTH=32
ARGON2_SALT_LENGTH=16
AUTH_ARGON2_MEMORY_COST=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1
AUTH_ARGON2_HASH_LENGTH=32
COMMON_PASSWORDS=
COMMON_PASSWORDS_PATH=
COMMON_PASSWORDS_PATH=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_BASE_SECONDS=1
LOGIN_LOCK_MAX_SECONDS=900
TYPEORM_LOGGING=false
TYPEORM_MIGRATIONS_RUN=false
JWT_PRIVATE_KEY_PATH=../secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=../secrets/jwt-public.pem
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

