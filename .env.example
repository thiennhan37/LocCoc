# Copy this file to .env and replace the sample passwords before starting.
POSTGRES_ADMIN_PASSWORD=postgres
KEYCLOAK_DB_PASSWORD=keycloak
USER_DB_PASSWORD=user
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=loc-coc
# Required before first import: exact HTTPS App Link / Universal Link callback.
MOBILE_REDIRECT_URI=

# Local development defaults. Use a reachable hostname for a real device.
KEYCLOAK_HOSTNAME=http://localhost:8180
KEYCLOAK_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5433
