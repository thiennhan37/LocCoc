POST_PORT=8089
POST_DB_URL=jdbc:postgresql://127.0.0.1:5433/posts
POST_DB_USER=postgres
POST_DB_PASSWORD=replace-me
POST_DB_DDL_AUTO=validate
USER_SERVICE_URL=http://127.0.0.1:8081
POST_S3_ENDPOINT=http://127.0.0.1:9000
POST_S3_REGION=us-east-1
POST_S3_BUCKET=loccoc-posts
POST_S3_PATH_STYLE=true
POST_S3_ACCESS_KEY=replace-me
POST_S3_SECRET_KEY=replace-me
POST_LEGACY_READ_ENABLED=false
SEMANTIC_SEARCH_ENABLED=false
# Must match the selected Python profile (768, 1536 or 3072).
EMBEDDING_DIM=768
POST_AI_SERVICE_URL=http://127.0.0.1:8087
# Must match ai-service; use independent random values of at least 32 characters.
AI_SERVICE_TOKEN=
AI_ACTOR_SECRET=
POST_WORKER_ENABLED=true
POST_ACCOUNT_EVENTS_ENABLED=true
KAFKA_BROKERS=127.0.0.1:9092
ACCOUNT_EVENTS_TOPIC=account.events
POST_ACCOUNT_CONSUMER_GROUP=post-service-accounts-v1
MOMENTS_MAX_PER_OWNER=1000
MOMENTS_UPLOADS_PER_HOUR=30
