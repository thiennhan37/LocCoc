# Copy into .env; use DIFFERENT random >=32-character values for the two secrets.
GEMINI_EMBEDDING_API_KEY=
SEMANTIC_SEARCH_ENABLED=false
AI_SERVICE_TOKEN=
AI_ACTOR_SECRET=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768
EMBEDDING_PROFILE_ID=gemini2-d768-imgv1-queryv1
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=moments_gemini2_d768_v1
REDIS_URL=redis://127.0.0.1:6379
# Zero means no outbound provider calls. Configure to match actual project quota.
GEMINI_QUERY_RPM=0
AI_OWNER_SEARCH_RPM=30
GEMINI_INGEST_RPM=0
GEMINI_DAILY_REQUEST_CAP=0
GEMINI_MONTHLY_REQUEST_CAP=0
PORT=8087
