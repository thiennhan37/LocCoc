# Copy into .env; use DIFFERENT random >=32-character values for the two secrets.
GEMINI_EMBEDDING_API_KEY=
SEMANTIC_SEARCH_ENABLED=false
AI_SERVICE_TOKEN=
AI_ACTOR_SECRET=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Translate visual search into English using the dedicated embedding credential.
# A cold query uses up to 2 query-budget reservations (translation + embedding).
QUERY_TRANSLATION_ENABLED=true
GEMINI_QUERY_TRANSLATION_MODEL=gemini-3.1-flash-lite
EMBEDDING_DIM=768
# Allowed dimensions: 768, 1536, 3072. Blank profile/collection derive from DIM.
# Explicit values must match the selected dimension; keep collections separate.
EMBEDDING_PROFILE_ID=
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=
REDIS_URL=redis://127.0.0.1:6379
# Zero means no outbound provider calls. Configure to match actual project quota.
GEMINI_QUERY_RPM=0
AI_OWNER_SEARCH_RPM=30
GEMINI_INGEST_RPM=0
GEMINI_DAILY_REQUEST_CAP=0
# Optional approved temporary budget: set both fields, including timezone/expiry.
# GEMINI_DAILY_REQUEST_CAP_OVERRIDE=150
# GEMINI_DAILY_REQUEST_CAP_OVERRIDE_UNTIL=2026-11-18T00:00:00+07:00
GEMINI_MONTHLY_REQUEST_CAP=0
PORT=8087

# Image enhancement shares this Python runtime; separate from semantic search.
IMAGE_ENHANCEMENT_ENABLED=false
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_INPUT_BYTES=10485760
AI_MAX_OUTPUT_BYTES=20971520
AI_MAX_IMAGE_PIXELS=40000000
# Separate image-generation budget; zero disables paid calls.
GEMINI_ENHANCEMENT_RPM=0
GEMINI_ENHANCEMENT_DAILY_CAP=0
GEMINI_ENHANCEMENT_MONTHLY_CAP=0
