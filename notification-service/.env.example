NODE_ENV=development
NOTIFICATION_PORT=8084
SERVICE_BIND_HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=5433
NOTIFICATION_DB_NAME=notifications
NOTIFICATION_DB_USER=notification_service
NOTIFICATION_DB_PASSWORD=
TYPEORM_MIGRATIONS_RUN=false
JWT_PUBLIC_KEY_PATH=../secrets/public.pem
JWT_ISSUER=loccoc-auth
JWT_AUDIENCE=loccoc-api
JWT_KID=loccoc-2026-01
INTERNAL_SERVICE_TOKEN=
AUTH_SERVICE_URL=http://127.0.0.1:8000
NOTIFICATION_CURSOR_SECRET=
KAFKA_BROKERS=127.0.0.1:9092
SOCIAL_EVENTS_TOPIC=social.events
KAFKA_SSL=false
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
OTP_EVENTS_TOPIC=auth.email-otp.v1
OTP_CONSUMER_GROUP=notification-email-otp-v1
OTP_EVENT_SECRET=
# Enabled automatically when BREVO_MAIL_API_KEY exists; false explicitly disables email delivery.
# EMAIL_OTP_ENABLED=false
# Prefer setting the existing key in root .env; service-local settings take precedence.
# BREVO_MAIL_API_KEY=
# Optional when the Brevo account has exactly one active verified sender.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=LocCoc
FCM_ENABLED=true
# Server-only absolute path; never commit a service-account file.
GOOGLE_APPLICATION_CREDENTIALS=../secrets/firebase-admin.json
