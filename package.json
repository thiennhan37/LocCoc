{
  "name": "loccoc-iam",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "start": "npm --prefix api-gateway run start",
    "start:gateway": "npm --prefix api-gateway run start",
    "start:auth": "npm --prefix auth-service run start",
    "start:user": "npm --prefix user-service run start",
    "start:admin": "mvn -f admin-service/pom.xml spring-boot:run",
    "start:payment": "mvn -f payment-service/pom.xml spring-boot:run",
    "build": "pnpm --filter @loccoc/common build && pnpm --filter api-gateway --filter auth-service --filter user-service --filter notification-service --filter chat-service build",
    "start:moment": "npm run start:post",
    "start:ai": "node scripts/start-ai.mjs",
    "build:admin": "mvn -f admin-service/pom.xml clean package -DskipTests",
    "build:payment": "mvn -f payment-service/pom.xml clean package -DskipTests",
    "test:e2e": "pnpm --filter api-gateway test:e2e",
    "dev": "npm --prefix admin-dashboard run dev -- --port 3005",
    "dev:dashboard": "npm --prefix admin-dashboard run dev -- --port 3005",
    "start:dashboard": "npm --prefix admin-dashboard run start",
    "dev:gateway": "pnpm --filter @loccoc/common build && pnpm --filter api-gateway start:dev",
    "dev:auth": "pnpm --filter @loccoc/common build && pnpm --filter auth-service start:dev",
    "dev:user": "pnpm --filter @loccoc/common build && pnpm --filter user-service start:dev",
    "dev:admin": "mvn -f admin-service/pom.xml spring-boot:run",
    "dev:payment": "mvn -f payment-service/pom.xml spring-boot:run",
    "webhook:register": "node scripts/register-webhook.js",
    "db:migrate:auth": "npm --prefix auth-service run db:migrate",
    "db:migrate:user": "npm --prefix user-service run db:migrate",
    "start:notification": "pnpm --filter notification-service build && pnpm --filter notification-service start",
    "start:dev": "npm --prefix api-gateway run start:dev",
    "dev:ai": "node scripts/start-ai.mjs --reload",
    "start:chat": "pnpm --filter @loccoc/common build && pnpm --filter chat-service build && pnpm --filter chat-service start",
    "dev:chat": "pnpm --filter @loccoc/common build && pnpm --filter chat-service start:dev",
    "db:migrate:chat": "pnpm --filter @loccoc/common build && pnpm --filter chat-service db:migrate",
    "start:post": "node scripts/start-post.mjs",
    "build:post": "mvn -f post-service/pom.xml package",
    "test:post": "mvn -f post-service/pom.xml test",
    "verify:moments": "node scripts/verify-moments.mjs",
    "db:import:moments": "java -jar post-service/target/post-service-0.0.1-SNAPSHOT.jar --spring.profiles.active=moment-import",
    "test:ai": "node scripts/start-ai.mjs --test"
  },
  "dependencies": {
    "jose": "^6.2.17",
    "kafkajs": "^2.2.4"
  }
}
