# AI Service 2 Configuration
APP_NAME=LocCoc AI Service 2
APP_ENV=development
PORT=8087
HOST=0.0.0.0

# Jina Model Configuration
# Path to local directory containing downloaded model weights, or Hugging Face model identifier
MODEL_NAME_OR_PATH=jinaai/jina-clip-v2
# Local model storage directory if pre-downloaded
LOCAL_MODEL_DIR=./models/jina-clip-v2
# Device to run model on: 'cuda', 'cpu', or 'auto' (detects cuda if available)
DEVICE=auto
# Dimension truncation for Matryoshka Representation Learning (MRL): 1024, 512, 256, 128
EMBEDDING_DIM=512

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=media_moments
