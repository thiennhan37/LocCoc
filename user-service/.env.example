NODE_ENV=development
USER_PORT=8081
SERVICE_BIND_HOST=127.0.0.1
AUTH_SERVICE_URL=http://127.0.0.1:8000
# Same random 32+ character token as AuthService and Gateway.
INTERNAL_SERVICE_TOKEN=779ec8146b2bcce2bd6b7cb7f0d854e36b0a828a084456a7c8ebda23ca283b43
KAFKA_BROKERS=127.0.0.1:9092
ACCOUNT_EVENTS_TOPIC=account.events
DB_HOST=127.0.0.1
DB_PORT=5433
USER_DB_NAME=users
USER_DB_USER=user_service
USER_DB_PASSWORD=user_dbpw
REDIS_URL=redis://127.0.0.1:6379
TYPEORM_LOGGING=false
TYPEORM_MIGRATIONS_RUN=false
JWT_PUBLIC_KEY_PATH=../secrets/jwt-public.pem
JWT_ISSUER=loccoc-auth
JWT_AUDIENCE=loccoc-api
JWT_KID=loccoc-2026-01

SOCIAL_EVENTS_TOPIC=social.events
KAFKA_SSL=false
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Smart friend discovery (same Neo4j password as root Docker Compose .env)
DISCOVERY_ENABLED=true
SOCIAL_GRAPH_EVENTS_TOPIC=social.graph.events
GRAPH_CONSUMER_GROUP=user-service-graph-v1
NEO4J_HTTP_URL=http://127.0.0.1:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=
DISCOVERY_CACHE_TTL_SECONDS=600
DISCOVERY_MAX_LAG_SECONDS=30

# Profile image uploads. Disabled until storage is provisioned.
MEDIA_ENABLED=false
MEDIA_S3_ENDPOINT=http://127.0.0.1:9000
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=loccoc-media
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
# Public bucket/CDN URL, reachable by the phone. HTTPS required in production.
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:9000/loccoc-media
MEDIA_ALLOWED_ORIGINS=
