NODE_ENV=development
CHAT_SERVICE_PORT=8083
SERVICE_BIND_HOST=127.0.0.1
AUTH_SERVICE_URL=http://127.0.0.1:8000
USER_SERVICE_URL=http://127.0.0.1:8081
# Use the same generated 32+ character token as auth-service; never send it to Flutter.
INTERNAL_SERVICE_TOKEN=
DB_HOST=127.0.0.1
# Match POSTGRES_HOST_PORT in the root .env when running outside Docker.
DB_PORT=5433
# Use the same database name and password in the root .env for provisioning.
CHAT_DB_NAME=chat
# The provisioning scripts create this fixed role.
CHAT_DB_USER=chat_service
CHAT_DB_PASSWORD=
TYPEORM_MIGRATIONS_RUN=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
