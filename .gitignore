# 1. Environment & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
secrets/
*.pem
*.key

# 2. Dependencies & Package Managers
**/node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 3. Next.js & Frontend Builds (admin-dashboard / web)
**/.next/
**/out/
**/dist/
**/build/
**/*.tsbuildinfo
.turbo/

# 4. Java / Spring Boot / Maven (admin-service / payment-service)
**/target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
.mvn/wrapper/maven-wrapper.jar
*.jar
*.war

# 5. Mobile Client (Flutter / Dart / Android / iOS)
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/MobileApp/build/
**/MobileApp/.dart_tool/

